# Copiar este archivo como ".env" y completar con tus claves

# API key gratuita de Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Modelo de Gemini a usar (dejar el que viene por defecto salvo que falle).
# Ojo: los alias "-latest" a veces enrutan a un modelo más pesado y lento
# (lo medimos en 30-45 segundos por respuesta, muy lento para una demo en
# vivo). Un modelo fijo como el de abajo respondió siempre en 1-7 segundos.
# Google va renombrando/retirando modelos con el tiempo: si en algún momento
# este deja de existir, ver los modelos disponibles en
# https://ai.google.dev/gemini-api/docs/models y elegir otro "flash-lite".
GEMINI_MODEL=gemini-3.1-flash-lite

# Puerto donde corre el servidor (uvicorn)
PORT=8000

# --- Solo necesario si van a conectar WhatsApp real con Meta WhatsApp Cloud API ---
# No hace falta completar esto para la demo simulada. Ver README.md para
# el paso a paso de cómo conseguir estos tres valores (es gratis).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Este lo inventan ustedes (cualquier palabra secreta) y lo pegan también
# en la configuración del webhook en Meta for Developers.
WHATSAPP_VERIFY_TOKEN=
